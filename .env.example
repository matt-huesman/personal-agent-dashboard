# Host-side development (pnpm dev / pnpm test / pnpm ingest) against the compose db.
DATABASE_URL=postgres://dashboard:dashboard@localhost:5432/dashboard
TEST_DATABASE_URL=postgres://dashboard:dashboard@localhost:5432/dashboard_test

# Defines "today" for day columns and roll-over. Also read by docker compose.
TZ=America/Chicago

# Google Drive (docs/google-setup.md). With DRIVE_FOLDER_ID set, ingest reads
# from Drive; without it, from data/incoming/. The last two are written by
# `pnpm drive:auth`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
DRIVE_FOLDER_ID=
