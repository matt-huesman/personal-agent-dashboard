{
	"name": "personal-agent-dashboard",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@10.18.0",
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"format": "prettier --write .",
		"db:up": "docker compose up -d db",
		"db:generate": "drizzle-kit generate",
		"ingest": "tsx --env-file-if-exists=.env scripts/ingest.ts"
	},
	"dependencies": {
		"drizzle-orm": "^0.45.3",
		"postgres": "^3.4.9",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.48.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22.0.0",
		"bits-ui": "^2.19.3",
		"cn": "^0.4.0",
		"drizzle-kit": "^0.31.11",
		"prettier": "^3.6.0",
		"prettier-plugin-svelte": "^3.4.0",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"svelte-dnd-action": "^0.9.79",
		"svelte-sonner": "^1.2.1",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.0",
		"vite": "^8.3.1",
		"vitest": "^5.0.1"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	}
}
